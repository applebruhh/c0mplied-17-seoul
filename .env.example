# Export these values into the backend process; .env is not loaded automatically.
VAULTPAY_DATABASE_PATH=./data/vaultpay-pos.sqlite3
# Reset is disabled unless this is set. Use X-Demo-Reset-Token, never URL params.
VAULTPAY_DEMO_RESET_TOKEN=
VAULTPAY_WORKER_INTERVAL=0.25
VAULTPAY_MOCK_STAGE_SECONDS=1
VAULTPAY_ENGINE_TIMEOUT=3
# ExternalPaymentAdapter is a disabled placeholder. No real financial API calls.
