# Export these values into the backend process; .env is not loaded automatically.
VAULTPAY_DATABASE_PATH=./data/vaultpay-pos.sqlite3
# Reset is disabled unless this is set. Use X-Demo-Reset-Token, never URL params.
VAULTPAY_DEMO_RESET_TOKEN=
VAULTPAY_WORKER_INTERVAL=0.25
VAULTPAY_MOCK_STAGE_SECONDS=1
VAULTPAY_ENGINE_TIMEOUT=3
# Finalized Phase 3 demo policy; set hold TTL to 60 for presentations.
VAULTPAY_MOCK_MARGIN=0.03
VAULTPAY_MOCK_MAX_SLIPPAGE=0.005
VAULTPAY_MOCK_HOLD_TTL=300
VAULTPAY_MOCK_UNKNOWN_SECONDS=5
# Mock is the default. Configure a separate database for a Phase 7B rehearsal.
PAYMENT_ENGINE_MODE=mock
# Origin only, no credentials, path, query, or fragment. Required in external mode.
PAYMENT_ENGINE_BASE_URL=
# Backend only. Required in external mode. Never use a VITE_ prefix.
SB_POS_HMAC_SECRET=
# Separate bearer credential for internal Ops. External Ops are disabled if unset.
VAULTPAY_OPS_TOKEN=
# Optional direct loopback demo. Start with python -m app.demo from backend.
DEMO_LOCAL_OPS=false
DEMO_LOCAL_OPS_ACCESS_CODE=
